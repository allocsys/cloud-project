{
  "name": "vtx-gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Vertexhash payment gateway: deposits, withdrawals, swaps. Separate service, shares nothing with the app except a signed webhook.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node -e \"import('./src/migrate.js').then((m) => m.migrate()).then(() => process.exit(0))\"",
    "test": "INVOICE_BUFFER_PERCENT=0 node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@noble/hashes": "1.7.1",
    "@scure/base": "1.2.4",
    "@scure/bip32": "1.6.2",
    "pg": "8.16.3"
  }
}
