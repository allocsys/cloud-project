{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/app/*app*/**",
      "/app/*plain*/**",
      "/app/*site*/**",
      "/app/status/**",
      "/app/healthz/**",
      "/app/icons/**",
      "/app/tonconnect-manifest.json/**",
      "/app/*.js",
      "/app/*.css",
      "/components/**",
      "/public/**",
      "/proxy.js",
      "/instrumentation.js",
      "/lib/*.js",
      "/lib/i18n/**",
      "/next.config.mjs",
      "/jsconfig.json",
      "/package.json",
      "/package-lock.json",
      "/Dockerfile",
      "/scripts/**"
    ]
  }
}
